+"""Opt-in colour policy `bt709-tv-gbrp-v1` (candidate).  The DEFAULT path must stay byte-for-byte the historical one.
+
+Plan-level tests run everywhere with no process.  One opt-in real-FFmpeg test (VIDEO_CORE_INTEGRATION=1) renders a single frame to
+rawvideo and compares it with an exact-rational BT.709 limited-range oracle; it asserts only the policy's own output (within one code),
+not the baseline's drift, because that drift is FFmpeg-build dependent (measured on 6.1.1 only).
+"""
+
+import json
+import os
+import shutil
+import subprocess
+import sys
+import unittest
+from fractions import Fraction as F
+
+from tests.helpers import ROOT, TmpCase, color_clips, episode_doc, no_process, sample_bytes, to_bytes
+from video_core import prepare
+from video_core.errors import ValidationFailed
+from video_core.plan import COLOR_POLICIES, COLOR_POLICY_GBRP_V1
+
+BASELINE_PLAN_SHA = "4bc20b3fd703f46651c868c1929efd3d9df3fc3c0a99f86607502ca92d5d9f21"
+FF = shutil.which("ffmpeg")
+ENABLED = os.environ.get("VIDEO_CORE_INTEGRATION") == "1" and FF
+OLD = "setpts=PTS-STARTPTS,scale=out_color_matrix=bt709:out_range=tv,setsar=1,format=yuv420p"
+NEW = "setpts=PTS-STARTPTS,format=gbrp,scale=out_color_matrix=bt709:out_range=tv,setsar=1,format=yuv420p"
+
+
+def graph(plan):
+    argv = plan.canonical["ffmpeg"]["argv"]
+    return argv[argv.index("-filter_complex") + 1]
+
+
+class DefaultUnchanged(TmpCase):
+    def test_default_hash_is_the_historical_baseline_hash(self):
+        p = prepare(sample_bytes())
+        self.assertEqual(p.sha256, BASELINE_PLAN_SHA)
+        self.assertEqual(prepare(sample_bytes(), color_policy=None).sha256, BASELINE_PLAN_SHA)
+
+    def test_default_canonical_has_no_policy_key_and_no_gbrp(self):
+        p = prepare(sample_bytes())
+        self.assertNotIn("color_policy", p.canonical)
+        self.assertNotIn(b"gbrp", p.canonical_json)
+
+    def test_committed_evidence_plan_is_byte_identical_to_the_default_plan(self):
+        with open(os.path.join(ROOT, "evidence", "plan.canonical.json"), "rb") as fh:
+            self.assertEqual(fh.read(), prepare(sample_bytes()).canonical_json)
+
+    def test_cli_default_output_is_unchanged_and_policy_is_opt_in(self):
+        def run(*extra):
+            env = {"PATH": os.environ.get("PATH", ""), "PYTHONPATH": ROOT, "PYTHONHASHSEED": "0"}
+            r = subprocess.run([sys.executable, "-m", "video_core", "plan", os.path.join(ROOT, "examples", "episode.synthetic.json"), *extra],
+                               capture_output=True, cwd=self.tmp, env=env, timeout=120)
+            self.assertEqual(r.returncode, 0, r.stderr)
+            return json.loads(r.stdout)
+        base, explicit, opt = run(), run("--color-policy", "baseline"), run("--color-policy", COLOR_POLICY_GBRP_V1)
+        self.assertEqual(base["plan_sha256"], BASELINE_PLAN_SHA)
+        self.assertEqual(base, explicit)
+        self.assertNotEqual(opt["plan_sha256"], BASELINE_PLAN_SHA)
+        self.assertEqual(opt["plan"]["color_policy"], COLOR_POLICY_GBRP_V1)
+
+
+class OptIn(TmpCase):
+    def test_policy_changes_only_the_colour_clips_scale_input_format(self):
+        base, opt = prepare(sample_bytes()), prepare(sample_bytes(), color_policy=COLOR_POLICY_GBRP_V1)
+        self.assertNotEqual(base.sha256, opt.sha256)
+        self.assertEqual(graph(base).count(OLD), 2)
+        self.assertEqual(graph(opt).count(NEW), 2)
+        self.assertEqual(graph(opt).replace("format=gbrp,", ""), graph(base))
+        a, b = dict(opt.canonical), dict(base.canonical)
+        self.assertEqual(a.pop("color_policy"), COLOR_POLICY_GBRP_V1)
+        a["ffmpeg"], b["ffmpeg"] = dict(a["ffmpeg"], argv=None), dict(b["ffmpeg"], argv=None)
+        self.assertEqual(a, b, "nothing but the filtergraph and the policy key differs")
+
+    def test_policy_plan_is_deterministic_and_machine_independent(self):
+        a = prepare(sample_bytes(), color_policy=COLOR_POLICY_GBRP_V1)
+        out = self.mkdir("deep", "out")
+        b = prepare(sample_bytes(), color_policy=COLOR_POLICY_GBRP_V1, output_root=out, output_name="x")
+        self.assertEqual(a.sha256, b.sha256)
+        self.assertNotIn(self.tmp.encode(), b.canonical_json)
+
+    def test_file_sources_are_untouched_by_the_policy(self):
+        assets = self.mkdir("assets")
+        self.write("assets/still.png", b"x")
+        clips = [{"id": "f", "start_frame": 0, "duration_frames": 90, "source": {"kind": "file", "path": "still.png"}},
+                 {"id": "c", "start_frame": 90, "duration_frames": 90, "source": {"kind": "color", "value": "#30506a"}}]
+        data = to_bytes(episode_doc(clips=clips))
+        base = prepare(data, asset_root=assets)
+        opt = prepare(data, asset_root=assets, color_policy=COLOR_POLICY_GBRP_V1)
+        self.assertEqual(graph(opt).count("format=gbrp"), 1, "only the colour clip gets gbrp")
+        self.assertEqual(graph(opt).replace("format=gbrp,", ""), graph(base))
+
+    def test_every_colour_clip_gets_the_policy(self):
+        data = to_bytes(episode_doc(total=60, clips=color_clips([20, 20, 20], ("#102030", "#ff0000", "#ffffff")), captions=[]))
+        self.assertEqual(graph(prepare(data, color_policy=COLOR_POLICY_GBRP_V1)).count("format=gbrp"), 3)
+
+    def test_unknown_policy_is_rejected_before_anything_else(self):
+        for bad in ("", "gbrp", "bt709-tv-gbrp-v2", "BASELINE", 1, True, ["bt709-tv-gbrp-v1"]):
+            with self.assertRaises(ValidationFailed, msg=repr(bad)) as cm:
+                with no_process():
+                    prepare(sample_bytes(), color_policy=bad)
+            self.assertEqual(cm.exception.issues[0].code, "color_policy_invalid")
+
+    def test_policy_registry_is_explicit(self):
+        self.assertEqual(COLOR_POLICIES, (COLOR_POLICY_GBRP_V1,))
+
+
+def _ideal_bt709_limited(rgb):
+    kr, kb = F(2126, 10000), F(722, 10000)
+    kg = 1 - kr - kb
+    r, g, b = (F(v, 255) for v in rgb)
+    y = kr * r + kg * g + kb * b
+    vals = (16 + 219 * y, 128 + 224 * (b - y) / (2 * (1 - kb)), 128 + 224 * (r - y) / (2 * (1 - kr)))
+    return tuple((v + F(1, 2)).__floor__() for v in vals)
+
+
+@unittest.skipUnless(ENABLED, "set VIDEO_CORE_INTEGRATION=1 with ffmpeg on PATH")
+class RealFfmpegSingleFrame(TmpCase):
+    COLOURS = ("#30506a", "#6a5030", "#ff0000", "#0000ff", "#808080", "#102030", "#e0b090")
+
+    def _codes(self, filtergraph):
+        out = os.path.join(self.tmp, "f.yuv")
+        subprocess.run([FF, "-v", "error", "-nostdin", "-y", "-threads", "2", "-filter_complex", filtergraph, "-map", "[v0]", "-frames:v", "1",
+                        "-f", "rawvideo", "-pix_fmt", "yuv420p", out], check=True, timeout=10)
+        with open(out, "rb") as fh:
+            buf = fh.read()
+        n = 16 * 16
+        return buf[0], buf[n], buf[n + n // 4]  # Y, Cb, Cr of the top-left sample of a flat 16x16 frame
+
+    def test_policy_output_is_within_one_code_of_the_exact_bt709_limited_oracle(self):
+        for colour in self.COLOURS:
+            data = to_bytes(episode_doc(total=1, width=16, height=16, clips=[{"id": "c", "start_frame": 0, "duration_frames": 1,
+                                                                              "source": {"kind": "color", "value": colour}}], captions=[]))
+            plan = prepare(data, color_policy=COLOR_POLICY_GBRP_V1)
+            g = graph(plan).split(";")[0]  # the single clip chain, ends with [v0]
+            rgb = tuple(int(colour[i:i + 2], 16) for i in (1, 3, 5))
+            got, want = self._codes(g), _ideal_bt709_limited(rgb)
+            self.assertLessEqual(max(abs(a - b) for a, b in zip(got, want)), 1, (colour, got, want))
+
+
+if __name__ == "__main__":
+    unittest.main()
